rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Logos de evento e de patrocinadores: leitura pública (a página de
    // inscrição/crachá precisa exibir sem login), upload só autenticado
    // (feito pelo admin.html). Escopado por evento.
    match /logos/{eventoId}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
