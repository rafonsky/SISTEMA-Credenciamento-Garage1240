rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function dadosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function souMaster() {
      return logado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        dadosUsuario().papel == 'master';
    }

    // Master gerencia tudo; Admin só os eventos liberados pra ele em
    // usuarios/{uid}.eventos_permitidos.
    function podeGerenciarEvento(eventoId) {
      return logado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        (dadosUsuario().papel == 'master' ||
         eventoId in dadosUsuario().get('eventos_permitidos', []));
    }

    // Papel/permissões de cada usuário logado. Master também pode ler e
    // editar o papel/eventos_permitidos de qualquer usuário (tela de gestão
    // de usuários no painel); criação de conta em si continua só via script
    // (criar_usuario.py), que também cria o documento inicial.
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || souMaster());
      allow write: if souMaster();
    }

    // Eventos: qualquer usuário autenticado pode ler (o filtro de quais
    // eventos aparecem é feito no app, conforme o papel); escrita restrita
    // a quem gerencia o evento — fecha o buraco de qualquer sessão anônima
    // (usada pelo check-in/inscrição pública) poder reescrever eventos.
    match /eventos/{eventoId} {
      allow read: if logado();
      allow write: if podeGerenciarEvento(eventoId);

      // Contador de código da inscrição pública. Criado pelo admin junto
      // com o evento; a página pública só precisa incrementar +1 por vez,
      // inclusive autenticada anonimamente.
      match /contadores/{contadorId} {
        allow read: if logado();
        allow create: if logado();
        allow update: if logado() &&
          request.resource.data.proximo == resource.data.proximo + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proximo']);
        allow delete: if false;
      }
    }

    // Participantes, organizados por evento
    match /participantes/{eventoId}/lista/{codigo} {
      allow read: if logado();
      // Cria um documento novo (nunca sobrescreve) em dois casos: a própria
      // inscrição pública, com consentimento LGPD marcado, OU quem gerencia
      // o evento importando uma lista pelo painel.
      allow create: if logado() && (
        (request.resource.data.origem == 'autoinscricao' && request.resource.data.consentimento_lgpd.aceito == true)
        || podeGerenciarEvento(eventoId)
      );
      allow update: if podeGerenciarEvento(eventoId); // corrigir cadastro, feito pelo Master/Admin
      allow delete: if podeGerenciarEvento(eventoId); // exclusão de dados por pedido LGPD, feita pelo Master/Admin
    }

    // "Cadeado" de e-mail: impede duas inscrições com o mesmo e-mail no
    // mesmo evento, mesmo contra um cliente adulterado — uma vez criado,
    // a regra nunca permite update, então não dá pra "recriar" por cima.
    match /participantes/{eventoId}/emails/{emailKey} {
      allow read: if logado();
      allow create: if logado();
      allow update: if false;
      allow delete: if podeGerenciarEvento(eventoId); // libera o e-mail de novo quando os dados são excluídos
    }

    match /checkins/{eventoId}/logs/{docId} {
      allow read, write: if logado();
    }
  }
}
